# ==============================================================================
# STREAMIX - Frontend Environment Variables (.env.local)
# Copy this file to .env.local to configure your local environment.
# ==============================================================================

# Core API & Video Streaming Engine
NEXT_PUBLIC_API_URL=/api
NEXT_PUBLIC_VIDEO_BASE_URL=https://embed.stream-service.org/1
NEXT_PUBLIC_ENABLE_EXTERNAL_STREAMING=true

# WebRTC Signaling Server URL (Default: local port 4000)
NEXT_PUBLIC_SIGNALING_URL=http://localhost:4000

# Optional: The Movie Database (TMDB) API v3 Key
# Streamix includes built-in offline static catalog & rich fallback datasets.
# Provide a key below to unlock live trending updates from TMDB.
TMDB_API_KEY=your_tmdb_api_key_here

# Optional: Gmail SMTP 6-Digit Email Verification Service
# If not configured, Streamix runs in simulated dev mode, logging the OTP code directly to console.
GMAIL_USER=your-email@gmail.com
GMAIL_APP_PASSWORD=your-16-character-app-password

# Optional: Remote Persistence Sync (Google Sheet / GitHub)
GOOGLE_SHEET_WEBHOOK_URL=https://script.google.com/macros/s/.../exec
GITHUB_REPO=
GITHUB_TOKEN=

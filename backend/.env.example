# ==============================================================================
# STREAMIX - Backend API Environment Variables (.env)
# Copy this file to .env to configure the Express backend.
# ==============================================================================

PORT=5000
JWT_SECRET=streamix-showcase-jwt-secret-replace-in-production

# Optional: TMDB API Key for live metadata queries
TMDB_API_KEY=your_tmdb_api_key_here

# Optional: MongoDB Connection String
# If omitted or unreachable, the backend automatically activates the in-memory data store.
MONGO_URI=mongodb://localhost:27017/streamix
